{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and role assignment for Kobujoi CDF system",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Verified email address"
        },
        "fullName": {
          "type": "string",
          "maxLength": 120,
          "description": "Full legal name"
        },
        "role": {
          "type": "string",
          "enum": ["student", "staff", "admin"],
          "maxLength": 20,
          "description": "System role"
        },
        "department": {
          "type": "string",
          "maxLength": 80,
          "description": "Department or ward assignment"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact phone number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": ["uid", "email", "fullName", "role", "department", "phone", "createdAt", "updatedAt"]
    },
