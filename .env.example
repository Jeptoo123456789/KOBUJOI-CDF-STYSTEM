# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MAP CONFIGURATION: Configurable map tile provider and optional API credentials
VITE_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_MAP_API_KEY=""

# NOTIFICATION & MESSAGING GATEWAYS (Optional Server/Provider Integration)
SMTP_HOST="smtp.example.go.ke"
SMTP_USER=""
SMTP_PASS=""
SMS_GATEWAY_API_KEY=""

# SECURITY & STORAGE CONFIGURATION
JWT_SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"
STORAGE_MAX_UPLOAD_BYTES="5242880"
